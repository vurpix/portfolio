---
import { Image } from "astro:assets";
import profileImage from "../assets/img/dbarreraFoto.jpg";
---

<section id="hero" class="hero section">
  <div class="container hero-container">
    <div class="hero-content">
      <span class="badge">👋 Hola, soy David Barrera</span>
      <h1 class="hero-title">
        Creo experiencias digitales <br />
        <span class="text-gradient">modernas y funcionales</span>
      </h1>
      <p class="hero-description">
        Transformo ideas en soluciones web de alto impacto. Especializado en
        desarrollo frontend y diseño de interfaces intuitivas.
      </p>
      <div class="hero-actions">
        <a href="#projects" class="btn btn-primary">Ver Proyectos</a>
        <a href="#contact" class="btn btn-secondary">Contáctame</a>
      </div>
    </div>

    <div class="hero-visual">
      <div class="image-container">
        <Image src={profileImage} alt="David Barrera" class="profile-image" />
        <div class="gradient-glow"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 90vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    padding-top: 8rem; /* Offset fixed header */
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-full);
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.9rem;
    color: hsl(var(--color-accent-primary));
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    line-height: 1.1;
  }

  .hero-description {
    font-size: 1.1rem;
    color: hsl(var(--color-text-muted));
    margin-bottom: 2.5rem;
    max-width: 50ch;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
  }

  .btn {
    padding: 0.8rem 1.5rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .btn-primary {
    background-color: hsl(var(--color-accent-primary));
    color: #fff;
  }

  .btn-secondary {
    background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: hsl(var(--color-text-main));
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn-primary:hover {
    box-shadow: 0 0 20px hsl(var(--color-accent-primary) / 0.4);
  }

  .btn-secondary:hover {
    border-color: hsl(var(--color-text-main));
  }

  /* Visual/Art */
      gap: 2rem;
    }

    .hero-visual {
      order: -1;
    }

    .hero-content {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-title {
      font-size: 2.5rem;
    }
  }
</style>
