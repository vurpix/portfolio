---
const services = [
  {
    title: "Desarrollo Móvil (Flutter)",
    description:
      "Apps nativas de alto rendimiento para iOS y Android. Especializado en lógica compleja, conexiones Bluetooth y hardware.",
    icon: "📱",
  },
  {
    title: "Desarrollo Web Fullstack",
    description:
      "Aplicaciones web modernas con React/Next.js y backends robustos en Node.js.",
    icon: "💻",
  },
  {
    title: "Apps Médicas & IoT",
    description:
      "Soluciones especializadas conectando hardware médico vía Bluetooth con aplicaciones móviles para terapias y monitoreo.",
    icon: "🏥",
  },
  {
    title: "E-commerce & AR",
    description:
      "Tiendas virtuales completas con integración de Realidad Aumentada para experiencias de compra inmersivas.",
    icon: "🛍️",
  },
];
---

<section id="services" class="section">
  <div class="container">
    <h2 class="section-title">
      Mis <span class="text-gradient">Servicios</span>
    </h2>

    <div class="services-grid">
      {
        services.map((service) => (
          <div class="service-card">
            <div class="service-icon">{service.icon}</div>
            <h3 class="service-title">{service.title}</h3>
            <p class="service-description">{service.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .service-card {
    background-color: rgba(255, 255, 255, 0.02);
    padding: 2.5rem;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.3s ease;
  }

  .service-card:hover {
    background-color: rgba(255, 255, 255, 0.05);
    transform: translateY(-5px);
    border-color: hsl(var(--color-accent-primary) / 0.5);
  }

  .service-icon {
    font-size: 3rem;
    margin-bottom: 1.5rem;
  }

  .service-title {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: hsl(var(--color-text-main));
  }

  .service-description {
    color: hsl(var(--color-text-muted));
    line-height: 1.6;
  }
</style>
